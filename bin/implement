#!/usr/bin/env bash
set -uo pipefail

schema='{
  "type":"object",
  "properties":{
    "status":{"type":"string","enum":["done","blocked","ready-for-human"]},
    "notes":{"type":"string"}
  },
  "required":["status","notes"]
}'

status_of() { sed -n 's/^\*\*Status:\*\* //p' "$1"; }

# Every ticket checked before any is run, so a bad one stops the batch
# before it starts rather than partway through.
todo=()
bad=()
for ticket in "$@"; do
  if [[ ! -f $ticket ]]; then
    bad+=("$ticket: no such file")
    continue
  fi
  case $(status_of "$ticket") in
    done) echo "== Skipping $ticket: already done" ;;
    ready-for-agent) todo+=("$ticket") ;;
    *) bad+=("$ticket: status '$(status_of "$ticket")'") ;;
  esac
done
if [[ ${#bad[@]} -gt 0 ]]; then
  echo "Not every ticket is done or ready-for-agent:"
  printf '  %s\n' "${bad[@]}"
  exit 1
fi

for ticket in "${todo[@]}"; do
  logs_dir=".scratch/logs"
  name=$(basename "$ticket" .md)
  mkdir -p "$logs_dir"
  log="$logs_dir/$name.jsonl"
  echo "== $(date +%Y-%m-%dT%H:%M:%S%z) $ticket (log: $log)"
  head_before=$(git rev-parse HEAD)
  # Chosen here so it is known before the run starts; inside the session it
  # is $CLAUDE_CODE_SESSION_ID.
  session_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
  echo "== $(date +%Y-%m-%dT%H:%M:%S%z) session: $session_id"

  claude -p "/implement $ticket, update status and commit" \
    --append-system-prompt "Spawn any sub-agents with run_in_background: false. Only give the final structured output once everything, including review fixes and the commit, is finished. Set the ticket's Status line to exactly \`**Status:** done\`, with nothing after it, only when every acceptance criterion is met and ticked: this script checks it word for word. If any criterion is unmet or only partly met, the ticket is not done: do not set done, set the Status to \`needs-info\` or \`ready-for-human\` (see docs/agents/triage-labels.md), say what is missing and why under a \`## Comments\` heading at the bottom of the ticket, commit what was built, and report status blocked. If every criterion is met as far as you can verify but the change needs a human to test it before the next ticket can be started, do not set done: set the Status to \`ready-for-human\`, say under \`## Comments\` exactly what the human should test and why an agent could not, commit what was built, and report status ready-for-human. A deliberate departure from the spec's wording that still meets every criterion is done; note it under \`## Comments\`. Every commit you make must carry the trailer \`Claude-Session: <id>\`, where <id> is the value of the environment variable \$CLAUDE_CODE_SESSION_ID: pass \`--trailer \"Claude-Session: \$CLAUDE_CODE_SESSION_ID\"\` to git commit and let the shell expand it." \
    --session-id "$session_id" \
    --model claude-opus-5-5 \
    --effort high \
    --permission-mode auto \
    --max-turns 300 \
    --output-format stream-json \
    --verbose \
    --json-schema "$schema" \
  | tee "$log" \
  | jq -rj '
      if .type == "assistant" then
        (.message.content[] |
          if .type == "text" then .text + "\n\n"
          elif .type == "tool_use" then "→ " + .name + " " + (.input | tostring) + "\n\n"
          else empty end)
      else empty end'
  rc=${PIPESTATUS[0]}

  subtype=$(jq -rs '[.[] | select(.type=="result")] | last | .subtype // "missing"' "$log")
  structured=$(jq -cs '[.[] | select(.type=="result" and .structured_output != null)] | last | .structured_output // {}' "$log")
  status=$(jq -r '.status // "unknown"' <<<"$structured")
  notes=$(jq -r '.notes // ""' <<<"$structured")
  ticket_status=$(status_of "$ticket")

  echo "== $(date +%Y-%m-%dT%H:%M:%S%z) subtype: $subtype"
  echo "== $(date +%Y-%m-%dT%H:%M:%S%z) status: $status (ticket: $ticket_status)"
  echo "== $(date +%Y-%m-%dT%H:%M:%S%z) notes:"
  echo "$notes"

  if [[ $rc -ne 0 || $subtype != "success" ]]; then
    echo "Run failed on $ticket (exit $rc, subtype $subtype)"; exit 1
  fi
  if [[ $(git rev-parse HEAD) == "$head_before" ]]; then
    echo "No commit made for $ticket"; exit 1
  fi
  if [[ $ticket_status == "ready-for-human" && $status == "ready-for-human" ]]; then
    echo "Ticket $ticket needs human testing before the next ticket; stopping here"; exit 0
  fi
  if [[ $ticket_status != "done" ]]; then
    echo "Ticket $ticket has status '$ticket_status' (Claude reported '$status')"; exit 1
  fi
  if [[ $status != "done" ]]; then
    echo "Warning: Claude reported '$status' but the ticket is done and committed"
  fi
  echo "OK"
done
