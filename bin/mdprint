#!/usr/bin/env python3
"""
mdprint - render a markdown file as a printable PDF that keeps every character
of the source. The raw markdown is syntax highlighted, line numbered and
soft-wrapped; top-level tables are drawn as a grid with the pipes kept.

Usage: mdprint [options] FILE.md

  -o, --output PATH   PDF to write (default: FILE.pdf next to the input)
  -l, --landscape     landscape instead of portrait
  -p, --paper SIZE    a4 (default) or letter
      --html          also keep the intermediate HTML next to the PDF
      --open          open the PDF when done

Needs Python 3.8+ and Google Chrome / Chromium / Edge / Brave (headless).
Set MDPRINT_CHROME to use a specific browser binary.
"""
import argparse
import glob
import html
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
from datetime import date


# ---------------------------------------------------------------- highlighting

def esc(s):
    return html.escape(s, quote=False)


def span(cls, text):
    return f'<span class="{cls}">{esc(text)}</span>'


INLINE = re.compile(
    r"(?P<code>`+)(?P<codebody>.+?)(?P=code)"
    r"|(?P<auto><)(?P<autourl>https?://[^>\s]+)>"
    r"|(?P<html><!--.*?-->|</?[A-Za-z][^>]*>)"
    r"|(?P<bold>\*\*|__)(?P<boldbody>.+?)(?P=bold)"
    r"|(?P<strike>~~)(?P<strikebody>.+?)~~"
    r"|(?<![\w*])(?P<em>\*)(?P<embody>[^*\s][^*]*?)\*(?![\w*])"
    r"|(?<![\w_])(?P<uem>_)(?P<uembody>[^_\s][^_]*?)_(?![\w_])"
    r"|(?P<link>!?\[)(?P<linktext>[^\]]+)\]\((?P<url>[^)]+)\)"
    r"|(?P<arrow>──→|→|←|─|│|▼|▲)"
)


def inline(text):
    out, pos = [], 0
    for m in INLINE.finditer(text):
        out.append(esc(text[pos:m.start()]))
        g = m.group
        if g("code"):
            t = g("code")
            out.append(f'<span class="ic">{span("mk", t)}{esc(g("codebody"))}{span("mk", t)}</span>')
        elif g("auto"):
            out.append(f'{span("mk", "<")}{span("lt", g("autourl"))}{span("mk", ">")}')
        elif g("html"):
            out.append(span("htm", g("html")))
        elif g("bold"):
            t = g("bold")
            out.append(f'<span class="b">{span("mk", t)}{inline(g("boldbody"))}{span("mk", t)}</span>')
        elif g("strike"):
            out.append(f'<span class="s">{span("mk", "~~")}{inline(g("strikebody"))}{span("mk", "~~")}</span>')
        elif g("em") or g("uem"):
            t = g("em") or g("uem")
            body = g("embody") if g("em") else g("uembody")
            out.append(f'<span class="i">{span("mk", t)}{inline(body)}{span("mk", t)}</span>')
        elif g("link"):
            out.append(
                f'{span("mk", g("link"))}<span class="lt">{inline(g("linktext"))}</span>'
                f'{span("mk", "](")}{span("url", g("url"))}{span("mk", ")")}'
            )
        elif g("arrow"):
            out.append(span("arrow", g("arrow")))
        pos = m.end()
    out.append(esc(text[pos:]))
    return "".join(out)


LIST = re.compile(r"^(\s*)([-*+]|\d+[.)])(\s+)(\[[ xX]\]\s+)?(.*)$")
HEAD = re.compile(r"^(#{1,6})(\s+)(.*)$")
HR = re.compile(r"^\s{0,3}([-*_])(\s*\1){2,}\s*$")
TABLE_SEP = re.compile(r"^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$")
FENCE_OPEN = re.compile(r"^(\s{0,3})(`{3,}|~{3,})(.*)$")
FRONT_KEY = re.compile(r"^(\s*)([^\s:#][^:]*?)(:)(\s.*|)$")


def line_table_row(line, header):
    parts = []
    for i, c in enumerate(split_pipes(line)):
        if i:
            parts.append(span("pipe", "|"))
        parts.append(f'<span class="th">{inline(c)}</span>' if header else inline(c))
    return "".join(parts)


def md_line(line, nxt):
    """One markdown line, rendered on its own. Returns (html, css_class, hang_ch)."""
    if not line.strip():
        return "", "", 0
    m = HEAD.match(line)
    if m:
        lvl = len(m.group(1))
        return span("hmk", m.group(1)) + esc(m.group(2)) + inline(m.group(3)), f"h h{lvl}", lvl + 1
    if HR.match(line):
        return span("hr", line), "hrline", 0
    if line.lstrip().startswith(">"):
        m = re.match(r"^(\s*>\s?)(.*)$", line)
        return span("qmk", m.group(1)) + inline(m.group(2)), "quote", len(m.group(1))
    if line.lstrip().startswith("|"):
        if TABLE_SEP.match(line):
            return span("pipe", line), "tbl", 0
        return line_table_row(line, nxt is not None and TABLE_SEP.match(nxt) is not None), "tbl", 2
    m = LIST.match(line)
    if m:
        indent, marker, sp, box, rest = m.groups()
        box = box or ""
        marker_html = span("lmk", marker) + esc(sp) + (span("cb", box) if box else "")
        hang = len(indent) + len(marker) + len(sp) + len(box)
        return esc(indent) + marker_html + inline(rest), "li", hang
    return inline(line), "", len(line) - len(line.lstrip(" "))


# ---------------------------------------------------------------------- tables

def split_pipes(line):
    """Split on unescaped pipes (GFM rules: code spans do not protect pipes)."""
    parts, buf, i = [], [], 0
    while i < len(line):
        if line[i] == "\\" and i + 1 < len(line):
            buf.append(line[i:i + 2])
            i += 2
        elif line[i] == "|":
            parts.append("".join(buf))
            buf = []
            i += 1
        else:
            buf.append(line[i])
            i += 1
    parts.append("".join(buf))
    return parts


def row_cells(line):
    """-> (lead, has_lead_pipe, cells, has_trail_pipe, trail). Concatenation
    lead + '|'? + '|'.join(cells) + '|'? + trail == line."""
    tokens = split_pipes(line)
    lead_pipe = line.lstrip().startswith("|")
    stripped = line.rstrip()
    trail_pipe = len(tokens) > 1 and stripped.endswith("|") and not stripped.endswith("\\|")
    if lead_pipe and trail_pipe and len(tokens) == 2:  # a lone "|"
        return tokens[0], True, [], False, tokens[1]
    lead = tokens.pop(0) if lead_pipe else ""
    trail = tokens.pop() if trail_pipe else ""
    return lead, lead_pipe, tokens, trail_pipe, trail


def is_table_start(lines, idx):
    line = lines[idx]
    if line.lstrip().startswith("|"):
        return True
    nxt = lines[idx + 1] if idx + 1 < len(lines) else None
    return "|" in line and nxt is not None and "|" in nxt and TABLE_SEP.match(nxt) is not None


def render_table(block, start_n):
    rows = [row_cells(l) for l in block]
    ncells = max(1, max(len(r[2]) for r in rows))
    sep_idx = next((i for i, l in enumerate(block) if TABLE_SEP.match(l)), None)

    weights = [0.0] * ncells
    for i, r in enumerate(rows):
        if i != sep_idx:
            for c, cell in enumerate(r[2]):
                weights[c] = max(weights[c], len(cell.strip()))
    weights = [max(w, 3) ** 0.5 for w in weights]
    total = sum(weights)
    cols = '<col class="c-no"><col class="c-pp0">' + "".join(
        ('<col class="c-pp">' if c else "") + f'<col style="width:{w / total * 100:.1f}%">'
        for c, w in enumerate(weights)
    ) + '<col class="c-pp">'

    out = [f'<table class="mdt"><colgroup>{cols}</colgroup>']
    for i, (lead, lp, cells, tp, trail) in enumerate(rows):
        kind = "sep" if i == sep_idx else ("head" if sep_idx is not None and i < sep_idx else "body")
        tds = [f'<td class="no">{start_n + i}</td>']
        tds.append(f'<td class="pp">{esc(lead)}{"|" if lp else ""}</td>')
        for c in range(ncells):
            if c:
                tds.append(f'<td class="pp">{"|" if c < len(cells) else ""}</td>')
            cell = cells[c] if c < len(cells) else ""
            body = span("sepd", cell) if kind == "sep" else inline(cell)
            tds.append(f'<td class="cell">{body}</td>')
        tds.append(f'<td class="pp">{"|" if tp else ""}{esc(trail)}</td>')
        out.append(f'<tr class="{kind}">{"".join(tds)}</tr>')
    out.append("</table>")
    return "".join(out)


# -------------------------------------------------------------------- document

def render_body(src):
    lines = re.split(r"\r?\n", src)
    if lines and lines[-1] == "":
        lines.pop()

    front_end = -1
    if lines and lines[0] == "---":
        front_end = next((i for i in range(1, len(lines)) if lines[i] in ("---", "...")), -1)

    rows = []
    keep_open = False  # heading waiting to be grouped with its first content

    def emit(row, is_heading=False, is_blank=False):
        nonlocal keep_open
        if is_heading and not keep_open:
            rows.append('<div class="keep">')
            keep_open = True
        rows.append(row)
        if keep_open and not is_heading and not is_blank:
            rows.append("</div>")
            keep_open = False

    fence = None  # (char, length, lang)
    idx = 0
    while idx < len(lines):
        line = lines[idx]
        n = idx + 1
        nxt = lines[idx + 1] if idx + 1 < len(lines) else None
        hang = 0

        if idx <= front_end:
            if idx in (0, front_end):
                body = span("fmk", line)
                cls = "front " + ("front-start" if idx == 0 else "front-end")
            else:
                m = FRONT_KEY.match(line)
                if m:
                    ind, k, colon, v = m.groups()
                    body = esc(ind) + span("key", k) + span("mk", colon) + span("val", v)
                    hang = len(ind) + len(k) + 2
                else:
                    body = span("val", line)
                    hang = len(line) - len(line.lstrip(" "))
                cls = "front"
        elif fence:
            close = re.match(r"^\s{0,3}(`{3,}|~{3,})\s*$", line)
            if close and close.group(1)[0] == fence[0] and len(close.group(1)) >= fence[1]:
                body, cls = span("fmk", line), "code code-end"
                fence = None
            elif fence[2] in ("markdown", "md"):
                nested = FENCE_OPEN.match(line)
                if nested:  # a fence inside the markdown example
                    body = esc(nested.group(1)) + span("fmk", nested.group(2)) + span("lang", nested.group(3))
                    c = ""
                else:
                    body, c, hang = md_line(line, nxt)
                cls = f"code {c}"
            else:
                body, cls, hang = esc(line), "code", len(line) - len(line.lstrip(" "))
        else:
            fm = FENCE_OPEN.match(line)
            if fm and not (fm.group(2)[0] == "`" and "`" in fm.group(3)):
                info = fm.group(3)
                fence = (fm.group(2)[0], len(fm.group(2)), (info.split() or [""])[0].lower())
                body = esc(fm.group(1)) + span("fmk", fm.group(2)) + span("lang", info)
                cls = "code code-start"
            elif is_table_start(lines, idx):
                end = idx
                while end + 1 < len(lines) and lines[end + 1].strip() and "|" in lines[end + 1]:
                    end += 1
                emit(render_table(lines[idx:end + 1], n))
                idx = end + 1
                continue
            else:
                body, cls, hang = md_line(line, nxt)

        style = f' style="--hang:{hang}ch"' if hang else ""
        emit(
            f'<div class="ln {cls}"{style}><span class="no">{n}</span>'
            f'<span class="tx">{body or "&#8203;"}</span></div>',
            is_heading=cls.startswith("h "),
            is_blank=not line.strip(),
        )
        idx += 1

    if keep_open:
        rows.append("</div>")
    return "\n".join(rows), len(lines)


def font_faces():
    dirs = [os.path.expanduser("~/Library/Fonts"), "/Library/Fonts",
            os.path.expanduser("~/.local/share/fonts"), os.path.expanduser("~/.fonts"),
            "/usr/share/fonts"]
    styles = [("Regular", 400, "normal"), ("Bold", 700, "normal"), ("Italic", 400, "italic"),
              ("BoldItalic", 700, "italic"), ("ExtraBold", 800, "normal")]
    # Prefer the no-ligature variants so "->", "!=" etc. print as typed.
    families = ["JetBrainsMonoNLNerdFontMono", "JetBrainsMonoNL", "JetBrainsMonoNLNerdFont"]
    for fam in families:
        found = {}
        for suffix, weight, style in styles:
            for d in dirs:
                hits = glob.glob(os.path.join(d, "**", f"{fam}-{suffix}.ttf"), recursive=True)
                if hits:
                    found[suffix] = (hits[0], weight, style)
                    break
        if "Regular" in found:
            return "\n".join(
                f'@font-face {{ font-family: MdPrintMono; font-weight: {w}; font-style: {s}; '
                f'src: url("file://{urllib.parse.quote(p)}"); }}'
                for p, w, s in found.values()
            )
    return ""


