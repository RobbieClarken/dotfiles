.fmk { color: var(--muted); }
.lang { color: var(--orange); font-weight: 700; }
"""


def build_html(src, title, subtitle, footer, page):
    body, count = render_body(src)
    gutter = f"{4.5 + max(3, len(str(count)))}mm"
    css_footer = footer.replace("\\", "\\\\").replace('"', '\\"')
    css = font_faces() + CSS.replace("__PAGE__", page).replace("__FOOTER__", css_footer)
    head, _, name = title.rpartition("/")
    title_html = (f"{esc(head)}<span>/</span>" if head else "") + esc(name)
    meta = "<br>".join(esc(x) for x in [subtitle, f"{count} lines"] if x)
    return f"""<!doctype html>
<html><head><meta charset="utf-8"><title>{esc(title)}</title>
<style>{css}</style></head>
<body style="--gutter:{gutter}">
<header><div class="title">{title_html}</div><div class="meta">{meta}</div></header>
{body}
</body></html>"""


# --------------------------------------------------------------------- context

def git(args, cwd):
    try:
        r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def describe(path):
    """-> (title, subtitle, footer) for the header and page footer."""
    d, name = os.path.split(path)
    parent = os.path.basename(d)
    title = f"{parent}/{name}" if parent else name
    top = git(["rev-parse", "--show-toplevel"], d)
    if top:
        rel = os.path.relpath(path, top)
        remote = git(["remote", "get-url", "origin"], top) or ""
        m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?/?$", remote)
        repo = m.group(1) if m else os.path.basename(top)
        commit = git(["log", "-1", "--format=%h · %cs", "--", rel], top)
        status = git(["status", "--porcelain", "--", rel], top) or ""
        state = "untracked" if status.startswith("??") else ("uncommitted changes" if status else "")
        return title, " · ".join(x for x in [repo, commit, state] if x), rel
    mtime = date.fromtimestamp(os.path.getmtime(path)).isoformat()
    try:
        footer = os.path.relpath(path)
    except ValueError:
        footer = path
    if footer.startswith(".."):
        footer = path.replace(os.path.expanduser("~"), "~", 1)
    return title, f"modified {mtime}", footer


def find_browser():
    env = os.environ.get("MDPRINT_CHROME")
    if env:
        return env
    for app in ["Google Chrome", "Chromium", "Microsoft Edge", "Brave Browser", "Google Chrome Canary"]:
        for root in ["/Applications", os.path.expanduser("~/Applications")]:
            p = f"{root}/{app}.app/Contents/MacOS/{app}"
            if os.access(p, os.X_OK):
                return p
    for name in ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser",
                 "microsoft-edge", "brave-browser", "chrome"]:
        p = shutil.which(name)
        if p:
            return p
    return None


# ------------------------------------------------------------------------ main

def main():
    ap = argparse.ArgumentParser(
        prog="mdprint",
        description="Render a markdown file as a pretty, printable PDF that keeps every character of the source.")
    ap.add_argument("file", help="markdown file to print")
    ap.add_argument("-o", "--output", help="PDF to write (default: FILE.pdf next to the input)")
    ap.add_argument("-l", "--landscape", action="store_true", help="landscape orientation")
    ap.add_argument("-p", "--paper", choices=["a4", "letter"], default="a4", help="paper size (default a4)")
    ap.add_argument("--html", action="store_true", help="also keep the intermediate HTML next to the PDF")
    ap.add_argument("--open", action="store_true", help="open the PDF when done")
    args = ap.parse_args()

    path = os.path.abspath(args.file)
    try:
        with open(path, encoding="utf-8-sig") as f:
            src = f.read()
    except (OSError, UnicodeDecodeError) as e:
        sys.exit(f"mdprint: cannot read {args.file}: {e}")

    out = os.path.abspath(args.output or os.path.splitext(path)[0] + ".pdf")
    page = f"{'A4' if args.paper == 'a4' else 'letter'} {'landscape' if args.landscape else 'portrait'}"
    title, subtitle, footer = describe(path)
    doc = build_html(src, title, subtitle, footer, page)

    browser = find_browser()
    if not browser:
        sys.exit("mdprint: no Chrome/Chromium found; set MDPRINT_CHROME to a browser binary")

    with tempfile.TemporaryDirectory(prefix="mdprint-") as tmp:
        html_path = os.path.join(tmp, "doc.html")
        with open(html_path, "w", encoding="utf-8") as f:
            f.write(doc)
        if os.path.exists(out):
            os.remove(out)
        r = subprocess.run(
            [browser, "--headless", "--disable-gpu", "--no-first-run", "--no-default-browser-check",
             f"--user-data-dir={os.path.join(tmp, 'profile')}", "--allow-file-access-from-files",
             "--no-pdf-header-footer", f"--print-to-pdf={out}", "file://" + urllib.parse.quote(html_path)],
            capture_output=True, text=True,
        )
        if not os.path.exists(out) or os.path.getsize(out) == 0:
            sys.exit(f"mdprint: browser failed to write {out}\n{r.stderr.strip()}")
        if args.html:
            shutil.copyfile(html_path, os.path.splitext(out)[0] + ".html")

    print(out)
    if args.open:
        subprocess.run(["open" if sys.platform == "darwin" else "xdg-open", out])


if __name__ == "__main__":
    main()
